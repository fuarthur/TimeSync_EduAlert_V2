<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/card_background" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" android:minHeight="96dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="?attr/colorOutline" app:strokeWidth="1dp">
